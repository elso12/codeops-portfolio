# ==============================================================================
# Addis Eats / Mesob House — Environment Configuration Template
# Module 3 · Day 43 (Performance, Optimization & Deployment Security)
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Fill in the sensitive values for your local development or staging environment.
# 3. NEVER commit .env.local or any file containing real production secrets to git.
# 4. Verify that .env*.local matches the .gitignore pattern.
#
# ==============================================================================
# 1. SERVER-SIDE ONLY SECRETS (NEVER PREFIX WITH NEXT_PUBLIC_)
# ==============================================================================
# These values are bundled exclusively into the server / Node.js runtime and are
# NEVER leaked to the client browser bundle.

# HMAC-SHA256 session signature key. Must be a cryptographically random string of at least 32 characters.
# Generate in terminal: openssl rand -base64 32
SESSION_SECRET=replace_with_a_secure_random_32_byte_secret_key_in_local_env

# Database connection URI (e.g., PostgreSQL / Neon / Supabase).
# Kept server-side to prevent database credential leakage.
DATABASE_URL=postgresql://user:password@localhost:5432/addis_eats?sslmode=require

# Telebirr / Ethio Telecom Merchant Integration Keys
# Used by server actions for server-to-server payment verification.
TELEBIRR_APP_ID=sample_telebirr_app_id
TELEBIRR_APP_KEY=sample_telebirr_app_key_secret
TELEBIRR_SHORT_CODE=100234
TELEBIRR_PUBLIC_KEY=sample_telebirr_public_key_pem

# ==============================================================================
# 2. CLIENT-SAFE PUBLIC CONFIGURATION (PREFIXED WITH NEXT_PUBLIC_)
# ==============================================================================
# These values are inlined into the client-side JavaScript bundle at build time.
# NEVER place API keys, private certificates, or database passwords here!

# Canonical site URL for client-side navigation, OG images, and public redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default display currency across client cart and menu components
NEXT_PUBLIC_DEFAULT_CURRENCY=ETB

# Cultural feature flag (enables Jebena Buna ceremony countdown widget)
NEXT_PUBLIC_ENABLE_BUNA_CEREMONY=true
